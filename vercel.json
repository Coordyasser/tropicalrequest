{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/n8n/nova",
      "destination": "https://n8n-webhook.72.60.7.155.sslip.io/webhook/8ca0b57f-4a07-41e9-8f90-7839821235ed"
    },
    {
      "source": "/api/n8n/aprovacao",
      "destination": "https://n8n-webhook.72.60.7.155.sslip.io/webhook/06bec45c-a4a9-4bdc-a4cd-a9c1fb64247d"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
